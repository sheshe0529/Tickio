generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoEvento {
  CONCIERTO
  DEPORTE
  TEATRO
  TRENDING
}

enum SubtipoEvento {
  INFANTIL
  GENERAL
  MAS18 // Representa "+18"
}

model Usuario {
  id Int @id @default(autoincrement())
  nombre String
  correo String @unique 
  contrasena String 
  telefono String
  rol String 
  Activa Int

  tipo1 TipoEvento?
  tipo2 TipoEvento?
  tipo3 TipoEvento?

  RUC          String?
  razon_social String?

  ticket Ticket[]


}


model Evento {
  id Int @id @default(autoincrement())
  nombre String
  descripcion String
  direccion String
  fecha_inicio DateTime
  fecha_fin DateTime
  hora_inicio Int
  duracion Int
  aforo Int
  estado String

  tipoEvento    TipoEvento  
  subtipo       SubtipoEvento 

  tipoTickets  Tipo_Ticket[]  // ← Agregado
  descuentos   Descuentos[]   // ← Agregado
}

model Tipo_Ticket {
  id        Int      @id @default(autoincrement())
  nombre    String
  precio    Float
  cantidad  Int

  eventoId  Int
  evento    Evento   @relation(fields: [eventoId], references: [id])

  tickets   Ticket[]
}

model Ticket {
  id           Int         @id @default(autoincrement())   
  fechaEmision DateTime                                    
  qr           Bytes?                                      
  nombre       String
  apellido     String
  dni          String
  estado       String

  tipoTicketId Int
  tipoTicket   Tipo_Ticket @relation(fields: [tipoTicketId], references: [id])

  usuarioId    Int 

  usuario      Usuario     @relation(fields: [usuarioId], references: [id])

  ordenId      Int
  orden        Orden       @relation(fields: [ordenId], references: [id])
}

model Orden {
  id          Int      @id @default(autoincrement())  
  estado      String                                 
  total       Float                                  
  estadoPago  String                                 

  tickets     Ticket[]                               
}

model Descuentos {
  id                  Int     @id @default(autoincrement())  
  nombre              String
  descuentoPorcentaje Int

  eventoId            Int
  evento              Evento  @relation(fields: [eventoId], references: [id])
}
